{
  "name": "khe-booth",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "node scripts/check-web-i18n.mjs && node scripts/check-globe-qa.mjs && pnpm -r --if-present lint",
    "lint:i18n": "node scripts/check-web-i18n.mjs",
    "lint:globe": "node scripts/check-globe-qa.mjs",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:seed": "pnpm --filter @khe/api exec ts-node prisma.seed.ts"
  },
  "prisma": {
    "seed": "pnpm --filter @khe/api exec ts-node prisma.seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "typescript": "^5.7.2"
  }
}
