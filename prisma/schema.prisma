generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  SHARE_HOST
}

enum EventStatus {
  DRAFT
  READY
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AspectRatio {
  PORTRAIT_9_16
  SQUARE_1_1
}

model Organization {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  users       User[]
  clients     Client[]
  events      Event[]
  presets     Preset[]
  activations EventActivation[]
  auditLogs   AuditLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  firstName      String?
  lastName       String?
  role           UserRole     @default(OPERATOR)
  isActive       Boolean      @default(true)
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  companyName    String?
  notes          String?
  events         Event[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

model Event {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?           @db.Uuid
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  presetId       String?           @db.Uuid
  preset         Preset?           @relation(fields: [presetId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  venueName      String?
  venueAddress   String?
  status         EventStatus       @default(DRAFT)
  activations    EventActivation[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@index([clientId])
}

model Preset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  aspectRatio    AspectRatio
  configuration  Json         @default("{}")
  events         Event[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model EventActivation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String       @db.Uuid
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, eventId])
  @@index([expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
