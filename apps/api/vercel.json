{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/marketing/email/system/process",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/system/events/complete-ended",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/stations/system/trash/purge",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/stations/system/notification-trash/purge",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/enterprise/onboarding/system/review-sla",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/commerce/system/subscriptions/lifecycle",
      "schedule": "25 4 * * *"
    },
    {
      "path": "/api/enterprise/onboarding/system/reverification",
      "schedule": "40 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
