{
  "expo": {
    "name": "KHE Booth",
    "slug": "khe-booth",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kurtishypnotic.khebooth",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kurtishypnotic.khebooth"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
